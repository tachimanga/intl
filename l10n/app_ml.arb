    "source_preference_check_input": "നിങ്ങളുടെ ഇൻപുട്ട് പരിശോധിക്കുക.",
    "reader_toolbar_close_reader": "റീഡർ അടയ്ക്കുക",
    "disable_content_sharing": "ഉള്ളടക്കം പങ്കിടൽ അപ്രാപ്തമാക്കുക",
    "disable_content_sharing_summary": "മാംഗ ലിങ്കുകളും ചിത്രങ്ങളും അബദ്ധത്തിൽ പങ്കിടുന്നത് തടയുക.",
    "content_sharing_disabled_title": "ഉള്ളടക്കം പങ്കിടൽ അപ്രാപ്തമാക്കിയിരിക്കുന്നു",
    "content_sharing_disabled_message": "ഉള്ളടക്കം വീണ്ടും പങ്കിടാൻ, {settings} → {security} എന്നതിലേക്ക് പോയി “{setting}” ഓഫാക്കുക.",
    "migration_help_title": "മൈഗ്രേഷൻ പതിവുചോദ്യങ്ങൾ",
    "migration_faq_prepare_q": "മൈഗ്രേറ്റ് ചെയ്യുന്നതിന് മുമ്പ് ഞാൻ എന്ത് ചെയ്യണം?",
    "migration_faq_prepare_a": "ഒരു ബാക്കപ്പ് സൃഷ്ടിക്കുക: ക്രമീകരണങ്ങൾ → ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കുക → ബാക്കപ്പ് സൃഷ്ടിക്കുക. ലക്ഷ്യ ഉറവിടങ്ങൾ ഇൻസ്റ്റാൾ ചെയ്തതും പ്രവർത്തനക്ഷമമാക്കിയതും തിരയാനും ചാപ്റ്ററുകൾ ലോഡ് ചെയ്യാനും കഴിയുന്നതുമാണെന്ന് ഉറപ്പാക്കുക.\n\nഡൗൺലോഡ് ചെയ്ത ചാപ്റ്ററുകളോ പ്രാദേശിക ഉറവിട ഫയലുകളോ ബാക്കപ്പുകളിൽ ഉൾപ്പെടില്ല.",
    "migration_faq_single_q": "ഒരു മാംഗ എങ്ങനെ മൈഗ്രേറ്റ് ചെയ്യാം?",
    "migration_faq_single_a": "1. മാംഗയുടെ കൂടുതൽ മെനു തുറക്കുക → മൈഗ്രേറ്റ് ചെയ്യുക.\n2. ലക്ഷ്യ മാംഗ തിരഞ്ഞ് തിരഞ്ഞെടുക്കുക.\n3. ആവശ്യാനുസരണം ചാപ്റ്ററുകൾ, വിഭാഗങ്ങൾ, ട്രാക്കിംഗ് എന്നിവ തിരഞ്ഞെടുക്കുക; യഥാർത്ഥ എൻട്രിയും അതിന്റെ ഡൗൺലോഡുകളും സൂക്ഷിക്കണോ എന്ന് സജ്ജീകരിക്കുക.\n4. മൈഗ്രേഷൻ ആരംഭിക്കുക ടാപ്പ് ചെയ്യുക.",
    "migration_faq_bulk_q": "ഒന്നിലധികം മാംഗകൾ എങ്ങനെ മൈഗ്രേറ്റ് ചെയ്യാം?",
    "migration_faq_bulk_a": "1. ലൈബ്രറിയിലെ ഒരു മാംഗ ദീർഘനേരം അമർത്തുക, മൈഗ്രേറ്റ് ചെയ്യേണ്ട എൻട്രികൾ തിരഞ്ഞെടുക്കുക, തുടർന്ന് മൈഗ്രേറ്റ് ചെയ്യുക തിരഞ്ഞെടുക്കുക. വ്യത്യസ്ത ഉറവിടങ്ങളിൽ നിന്നുള്ള മാംഗകൾ തിരഞ്ഞെടുക്കാം. ആദ്യം ഉറവിടം പ്രകാരം ഫിൽട്ടർ ചെയ്യാൻ, ലൈബ്രറി ഫിൽട്ടറുകളിലെ ഉറവിടങ്ങൾ ഉപയോഗിക്കുക.\n2. ലക്ഷ്യ ഉറവിടങ്ങൾ തിരഞ്ഞെടുത്ത് ക്രമീകരിക്കുക. മൈഗ്രേഷൻ ക്രമീകരണങ്ങളിൽ, കൈമാറേണ്ട ഡാറ്റ, യഥാർത്ഥ എൻട്രി, ഡൗൺലോഡ് ഓപ്ഷനുകൾ, പൊരുത്തപ്പെടുത്തൽ തന്ത്രം എന്നിവ തിരഞ്ഞെടുക്കുക.\n3. പൊരുത്തങ്ങൾ പരിശോധിക്കുക. ഒന്ന് തിരുത്താൻ, സ്വയം തിരയുക → ഒരു ലക്ഷ്യം തിരഞ്ഞെടുക്കുക → ഈ എൻട്രി തിരഞ്ഞെടുക്കുക ഉപയോഗിക്കുക. ഒരു എൻട്രി ഒഴിവാക്കാൻ മൈഗ്രേറ്റ് ചെയ്യരുത് ഉപയോഗിക്കുക.\n4. തുടരുക ടാപ്പ് ചെയ്യുക, ബാച്ച് പരിശോധിക്കുക, മൈഗ്രേറ്റ് ചെയ്യുന്നതിന് മുമ്പ് ഒരു ബാക്കപ്പ് സൃഷ്ടിക്കുക പ്രവർത്തനക്ഷമമാക്കുക, തുടർന്ന് മൈഗ്രേഷൻ ആരംഭിക്കുക ടാപ്പ് ചെയ്യുക.\n\nപൊരുത്തപ്പെടുത്തൽ നിങ്ങളുടെ ലൈബ്രറിയിൽ മാറ്റം വരുത്തില്ല. ബാച്ചിൽ നിങ്ങൾ നിലനിർത്തുന്ന പൊരുത്തപ്പെട്ട എൻട്രികൾ മാത്രം മൈഗ്രേറ്റ് ചെയ്യും. പൂർത്തിയായ ശേഷം, നിങ്ങളുടെ ലൈബ്രറിയും വായനാ പുരോഗതിയും പരിശോധിക്കുക.",
    "migration_faq_strategy_q": "ഏത് പൊരുത്തപ്പെടുത്തൽ തന്ത്രമാണ് ഞാൻ തിരഞ്ഞെടുക്കേണ്ടത്?",
    "migration_faq_strategy_a": "വിശ്വസനീയമായ കുറച്ച് ഉറവിടങ്ങൾ തിരഞ്ഞെടുക്കുക, നിങ്ങൾ ഇഷ്ടപ്പെടുന്നവ ആദ്യം വയ്ക്കുക.\n\n• പകരമുള്ളതോടുകൂടിയ ആദ്യ ഉറവിടം ഉപയോഗിക്കുക: ക്രമത്തിൽ തിരഞ്ഞ്, അനുയോജ്യമായ ആദ്യ പൊരുത്തത്തിൽ നിർത്തും.\n• ഏറ്റവും കൂടുതൽ ചാപ്റ്ററുകളുള്ള ഉറവിടം ഉപയോഗിക്കുക (വേഗത കുറവ്), പ്രീമിയം: തിരഞ്ഞെടുത്ത എല്ലാ ഉറവിടങ്ങളിലുമുള്ള പൊരുത്തങ്ങൾ താരതമ്യം ചെയ്ത്, ഏറ്റവും കൂടുതൽ ചാപ്റ്ററുകളുള്ളത് തിരഞ്ഞെടുക്കും.\n\nസ്വയമേവയുള്ള പൊരുത്തങ്ങൾ വ്യത്യസ്ത പതിപ്പോ ഭാഷയോ ആയിരിക്കാം. മൈഗ്രേറ്റ് ചെയ്യുന്നതിന് മുമ്പ് അവ പരിശോധിക്കുക.",
    "migration_faq_errors_q": "പൊരുത്തമൊന്നും കണ്ടെത്തിയില്ലെങ്കിലോ മൈഗ്രേഷൻ പരാജയപ്പെട്ടാലോ എന്ത് ചെയ്യും?",
    "migration_faq_errors_a": "ചെറിയ തലക്കെട്ടോ പകരമുള്ള പേരോ ഉപയോഗിച്ച് സ്വയം തിരയുക പരീക്ഷിക്കുക. പ്രതീക്ഷിച്ച ഉറവിടം കാണുന്നില്ലെങ്കിൽ, പിൻ ചെയ്ത ഉറവിടങ്ങളിൽ മാത്രം തിരയുക പരിശോധിക്കുക.\n\nപൊരുത്തപ്പെടുത്തൽ പൂർത്തിയാകാതിരുന്നാൽ, കാത്തിരിക്കുക ശേഷിക്കുന്ന തിരയലുകൾ പൂർത്തിയാക്കാൻ അനുവദിക്കും. ഇപ്പോൾ മൈഗ്രേറ്റ് ചെയ്യുക അവ നിർത്തി, ഇതിനകം കണ്ടെത്തിയ പൊരുത്തങ്ങളുമായി മുന്നോട്ട് പോകും.\n\nചില എൻട്രികൾ വിജയിച്ചേക്കാം, മറ്റുള്ളവ പരാജയപ്പെട്ടാലും. പൂർത്തീകരണ സംഗ്രഹവും ലൈബ്രറിയും പരിശോധിക്കുക. വീണ്ടും ശ്രമിക്കുന്നതിന് മുമ്പ്, ശേഷിക്കുന്ന എൻട്രികളുടെ ലക്ഷ്യ ഉറവിടങ്ങൾക്ക് അവയുടെ മാംഗയും ചാപ്റ്ററുകളും ലോഡ് ചെയ്യാൻ കഴിയുന്നുണ്ടെന്ന് ഉറപ്പാക്കി, ഇപ്പോഴും മൈഗ്രേഷൻ ആവശ്യമുള്ള എൻട്രികൾ മാത്രം വീണ്ടും ശ്രമിക്കുക.",
    "backup_help_title": "ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കൽ പതിവുചോദ്യങ്ങൾ",
    "local_source_help_title": "പ്രാദേശിക ഉറവിടം പതിവുചോദ്യങ്ങൾ",
    "backup_faq_create_q": "ഒരു ബാക്കപ്പ് എങ്ങനെ സൃഷ്ടിച്ച് എക്സ്പോർട്ട് ചെയ്യാം?",
    "backup_faq_create_a": "1. കൂടുതൽ → ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കുക → ബാക്കപ്പ് സൃഷ്ടിക്കുക തുറക്കുക.\n2. പൂർത്തിയായാൽ, ബാക്കപ്പിന്റെ മെനു തുറക്കുക → എക്സ്പോർട്ട് ചെയ്യുക. താച്ചിമാംഗയുടെ ഫോൾഡറിന് പുറത്തായി ഒരു പകർപ്പ് സൂക്ഷിക്കുകയോ മറ്റൊരു ഉപകരണത്തിലേക്ക് മാറ്റുകയോ ചെയ്യുക.\n\nപ്രാദേശിക ബാക്കപ്പുകൾ ഫയലുകൾ → എന്റെ iPhone-ൽ അല്ലെങ്കിൽ എന്റെ iPad-ൽ → താച്ചിമാംഗ → backups എന്നതിൽ സൂക്ഷിക്കുന്നു.\n\nപുനഃസ്ഥാപിക്കുന്നതിനും മൈഗ്രേറ്റ് ചെയ്യുന്നതിനും ഉപകരണങ്ങൾ മാറ്റുന്നതിനും മുമ്പ് പുതിയൊരു ബാക്കപ്പ് സൃഷ്ടിക്കുക. താച്ചിമാംഗ അൺഇൻസ്റ്റാൾ ചെയ്യുന്നത് ആപ്പിനുള്ളിൽ സൂക്ഷിച്ച ബാക്കപ്പുകൾ ഇല്ലാതാക്കാം.",
    "backup_faq_restore_q": "ഒരു താച്ചിമാംഗ ബാക്കപ്പ് എങ്ങനെ പുനഃസ്ഥാപിക്കാം?",
    "backup_faq_restore_a": "1. കൂടുതൽ → ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കുക → ബാക്കപ്പ് പുനഃസ്ഥാപിക്കുക തുറന്ന് ഒരു .tmb അല്ലെങ്കിൽ പഴയ താച്ചിമാംഗ .zip ബാക്കപ്പ് തിരഞ്ഞെടുക്കുക. പട്ടികയിലെ ബാക്കപ്പിനായി, അതിന്റെ മെനു → പുനഃസ്ഥാപിക്കുക ഉപയോഗിക്കുക.\n2. നിലവിലെ ഡാറ്റ ബാക്കപ്പ് ചെയ്യാനുള്ള ഓപ്ഷൻ പ്രവർത്തനക്ഷമമായി നിലനിർത്തുക. പുനഃസ്ഥാപിക്കൽ നിങ്ങളുടെ നിലവിലെ ലൈബ്രറിയും ബാക്കപ്പ് ചെയ്ത ക്രമീകരണങ്ങളും മാറ്റിസ്ഥാപിക്കും; അവ ലയിപ്പിക്കില്ല.\n3. സ്ഥിരീകരിക്കുക, പൂർത്തിയാകുന്നത് വരെ കാത്തിരിക്കുക, പുനരാരംഭിക്കാനുള്ള നിർദേശം പിന്തുടരുക.\n\nബാക്കപ്പ് പുതിയ ആപ്പ് ബിൽഡിൽ സൃഷ്ടിച്ചതാണെങ്കിൽ, ആദ്യം താച്ചിമാംഗ അപ്ഡേറ്റ് ചെയ്യുക.",
    "backup_faq_included_q": "ഒരു ബാക്കപ്പിൽ എന്തൊക്കെ ഉൾപ്പെടും?",
    "backup_faq_included_a": "താച്ചിമാംഗ ബാക്കപ്പുകളിൽ ലൈബ്രറി റെക്കോർഡുകൾ, വിഭാഗങ്ങൾ, വായനാ പുരോഗതി, ബുക്ക്മാർക്കുകൾ, വായനാ ചരിത്രം, ട്രാക്കിംഗ് റെക്കോർഡുകൾ, ഇൻസ്റ്റാൾ ചെയ്ത എക്സ്റ്റൻഷനുകൾ, ബാക്കപ്പ് ചെയ്ത ക്രമീകരണങ്ങൾ എന്നിവ ഉൾപ്പെടും.\n\nഡൗൺലോഡ് ചെയ്ത ചാപ്റ്ററുകളും പ്രാദേശിക ഉറവിട ഫയലുകളും ഒഴിവാക്കിയിരിക്കുന്നു. പ്രാദേശിക ഫയലുകൾ പ്രത്യേകം പകർത്തുക; ഡൗൺലോഡ് ചെയ്ത ചാപ്റ്ററുകൾ വീണ്ടും ഡൗൺലോഡ് ചെയ്യേണ്ടി വന്നേക്കാം.",
    "backup_faq_automatic_q": "സ്വയമേവയുള്ള ബാക്കപ്പുകൾ എങ്ങനെ പ്രവർത്തിക്കുന്നു?",
    "backup_faq_automatic_a": "സ്വയമേവയുള്ള ബാക്കപ്പിന് പ്രീമിയം ആവശ്യമാണ്. ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കുക എന്നതിൽ ബാക്കപ്പ് ഇടവേളയും സൂക്ഷിക്കൽ പരിധിയും സജ്ജമാക്കുക. പരിധിയിലെത്തുമ്പോൾ പഴയ സ്വയമേവയുള്ള ബാക്കപ്പുകൾ നീക്കം ചെയ്തേക്കാം.\n\nഏറ്റവും പുതിയ ബാക്കപ്പിന്റെ തീയതി പരിശോധിച്ച് പ്രധാനപ്പെട്ട ബാക്കപ്പുകൾ ആപ്പിന് പുറത്ത് എക്സ്പോർട്ട് ചെയ്യുക.",
    "backup_faq_mihon_q": "Mihon അല്ലെങ്കിൽ അനുയോജ്യമായ ബാക്കപ്പ് എങ്ങനെ ഇമ്പോർട്ട് ചെയ്യാം?",
    "backup_faq_mihon_a": "ബാക്കപ്പ് & പുനഃസ്ഥാപിക്കുക എന്നതിൽ, ലഭ്യമാണെങ്കിൽ Mihon ബാക്കപ്പ് ഇമ്പോർട്ട് ചെയ്യുക ഉപയോഗിക്കുക. ഫയൽ തിരഞ്ഞെടുക്കുക, ഇമ്പോർട്ട് ഓപ്ഷനുകൾ പരിശോധിക്കുക, നിലവിലെ ഡാറ്റ ബാക്കപ്പ് ചെയ്യാനുള്ള ഓപ്ഷൻ പ്രവർത്തനക്ഷമമായി നിലനിർത്തുക.\n\nഇത് പിന്തുണയ്ക്കുന്ന ലൈബ്രറിയും വായനാ ഡാറ്റയും ഇമ്പോർട്ട് ചെയ്യും. ചില ക്രമീകരണങ്ങളും എക്സ്റ്റൻഷനുകളും കൈമാറിയേക്കില്ല. ശേഷം ഇമ്പോർട്ട് ഫലവും ലൈബ്രറിയും പരിശോധിക്കുക.",
    "local_source_faq_import_q": "ലോക്കൽ മാംഗ എങ്ങനെ ഇമ്പോർട്ട് ചെയ്യാം?",
    "local_source_faq_import_a": "ബ്രൗസ് → സോഴ്സുകൾ → ലോക്കൽ സോഴ്സ് തുറക്കുക, + ബട്ടൺ ടാപ്പ് ചെയ്ത് ഫയലുകളിൽ നിന്ന് ZIP, CBZ, അല്ലെങ്കിൽ EPUB ഫയൽ തിരഞ്ഞെടുക്കുക.\n\nഇമ്പോർട്ട് ചെയ്യുന്ന ഓരോ ഫയലും അതിന്റെ പേരിലുള്ള മാംഗ ഫോൾഡറിൽ വയ്ക്കുകയും ഒരു അധ്യായമായി കണക്കാക്കുകയും ചെയ്യും. നിരവധി അധ്യായങ്ങൾ ഒരൊറ്റ മാംഗയായി സൂക്ഷിക്കാൻ, താഴെ വിവരിച്ച ഘടന ഉപയോഗിച്ച് ലോക്കൽ ഫോൾഡറിൽ ക്രമീകരിക്കുക.\n\nലോക്കൽ സോഴ്സ് നിങ്ങളുടെ ഉപകരണത്തിൽ സൂക്ഷിച്ചിരിക്കുന്ന ഫയലുകൾ വായിക്കുന്നു; മൂന്നാം കക്ഷി എക്സ്റ്റൻഷൻ ആവശ്യമില്ല.",
    "local_source_faq_folders_q": "ഫോൾഡറുകളും അധ്യായങ്ങളും എങ്ങനെ ക്രമീകരിക്കണം?",
    "local_source_faq_folders_a": "ഫയലുകളിൽ എന്റെ iPhone അല്ലെങ്കിൽ എന്റെ iPad → Tachimanga → local തുറക്കുക. ഓരോ മാംഗയ്ക്കും ഓരോ ഫോൾഡർ സൃഷ്ടിക്കുക, തുടർന്ന് ഓരോ അധ്യായവും ആ ഫോൾഡറിനുള്ളിൽ ആർക്കൈവായോ ചിത്രങ്ങളുടെ ഫോൾഡറായോ വയ്ക്കുക.\n\nഉദാഹരണങ്ങൾ:\nlocal/My Manga/Chapter 001.cbz\nlocal/My Manga/Chapter 002/001.jpg\nlocal/My Manga/Chapter 002/002.jpg\nlocal/My Manga/cover.jpg\n\nഅധ്യായ ആർക്കൈവുകൾ നേരിട്ട് local-നുള്ളിൽ വയ്ക്കരുത്. ചിത്ര അധ്യായങ്ങൾക്ക്, ചിത്രങ്ങൾ നേരിട്ട് അധ്യായ ഫോൾഡറിനുള്ളിൽ സൂക്ഷിക്കുക. അധ്യായങ്ങളുടെയും പേജുകളുടെയും ക്രമം പ്രവചിക്കാവുന്നതാക്കാൻ Chapter 001, 001.jpg പോലുള്ള പൂജ്യം ചേർത്ത പേരുകൾ ഉപയോഗിക്കുക.",
    "local_source_faq_formats_q": "ലോക്കൽ സോഴ്സിന് ഏതെല്ലാം ഫോർമാറ്റുകൾ വായിക്കാനാകും?",
    "local_source_faq_formats_a": "ചിത്രങ്ങളുള്ള അധ്യായ ഫോൾഡറുകൾ, ZIP/CBZ, RAR/CBR, EPUB എന്നിവ ലോക്കൽ സോഴ്സ് പിന്തുണയ്ക്കുന്നു. സാധാരണ ഇമേജ് ഫോർമാറ്റുകളിൽ JPG, PNG, WebP, GIF എന്നിവ ഉൾപ്പെടുന്നു. + ഇമ്പോർട്ട് ബട്ടൺ ZIP, CBZ, EPUB എന്നിവ സ്വീകരിക്കും; പിന്തുണയ്ക്കുന്ന മറ്റു ഫോർമാറ്റുകൾ ലോക്കൽ ഫോൾഡറിൽ വയ്ക്കാൻ ഫയലുകൾ ഉപയോഗിക്കുക.\n\nഓരോ ആർക്കൈവും ഒരു അധ്യായമാണ്. ZIP/CBZ ചിത്രങ്ങൾ ആ അധ്യായത്തിനുള്ളിലെ പേജുകളായി വായിക്കും; ആർക്കൈവിനുള്ളിലെ ഫോൾഡറുകൾ പ്രത്യേക അധ്യായങ്ങൾ സൃഷ്ടിക്കില്ല.\n\nഇമേജ് ഫോൾഡറുകളും ZIP/CBZ-യും ശുപാർശ ചെയ്യുന്നു. RAR/CBR അനുയോജ്യത പരിമിതമാണ്: RAR5, എൻക്രിപ്റ്റ് ചെയ്ത, സോളിഡ്, മൾട്ടി-വോള്യം RAR ആർക്കൈവുകൾ പിന്തുണയ്ക്കുന്നില്ല. ഒരു ആർക്കൈവ് തുറക്കാനാകുന്നില്ലെങ്കിൽ, ചിത്രങ്ങൾ എക്സ്ട്രാക്റ്റ് ചെയ്ത് പകരം ZIP/CBZ ഫയൽ സൃഷ്ടിക്കുക.",
    "migration_keep_original": "ലൈബ്രറിയിൽ യഥാർത്ഥ എൻട്രികൾ സൂക്ഷിക്കുക",
    "migration_delete_original_downloads": "യഥാർത്ഥ ഡൗൺലോഡുകൾ ഇല്ലാതാക്കുക",
